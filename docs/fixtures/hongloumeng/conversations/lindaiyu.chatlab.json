    },
    {
      "sender": "whomi-fiction-hongloumeng-jiabaoyu",
      "accountName": "贾宝玉",
      "timestamp": 1769997600,
      "type": 0,
      "content": "你今早怎么见了我就走？",
      "platformMessageId": "whomi-hongloumeng-v1-dai04-001"
    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1769997645,
      "type": 0,
      "content": "不走做什么，再等着吃一次闭门羹？",
