    },
    {
      "sender": "whomi-fiction-hongloumeng-jiabaoyu",
      "accountName": "贾宝玉",
      "timestamp": 1768890825,
      "type": 0,
      "content": "是《西厢记》。写得真好，你看几页就知道了。",
