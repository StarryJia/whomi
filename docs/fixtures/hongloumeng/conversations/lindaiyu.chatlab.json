    },
    {
      "sender": "whomi-fiction-hongloumeng-jiabaoyu",
      "accountName": "贾宝玉",
      "timestamp": 1769069205,
      "type": 0,
      "content": "我还当你又要劝我放下这书。",
      "platformMessageId": "whomi-hongloumeng-v1-dai03-010"
    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1769069250,
      "type": 0,
      "content": "我自己还没看完，劝你做什么。",
