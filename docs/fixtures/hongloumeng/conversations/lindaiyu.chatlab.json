    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1768889475,
      "type": 0,
      "content": "花又不会专往花上踩。",
      "platformMessageId": "whomi-hongloumeng-v1-dai01-016"
    },
    {
      "sender": "whomi-fiction-hongloumeng-jiabaoyu",
      "accountName": "贾宝玉",
      "timestamp": 1768889520,
      "type": 0,
      "content": "好，我站住。袋子给我拿着。",
