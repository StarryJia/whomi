    },
    {
      "sender": "whomi-fiction-hongloumeng-jiabaoyu",
      "accountName": "贾宝玉",
      "timestamp": 1769997870,
      "type": 0,
      "content": "宝姐姐来坐了一会儿。可我要是知道你来了——",
      "platformMessageId": "whomi-hongloumeng-v1-dai04-007"
    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1769997915,
