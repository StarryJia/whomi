    },
    {
      "sender": "whomi-fiction-hongloumeng-jiabaoyu",
      "accountName": "贾宝玉",
      "timestamp": 1768891365,
      "type": 0,
      "content": "都怕。",
      "platformMessageId": "whomi-hongloumeng-v1-dai02-018"
    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1768891410,
      "type": 0,
      "content": "这倒肯说实话。",
      "platformMessageId": "whomi-hongloumeng-v1-dai02-019"
    },
    {
      "sender": "whomi-fiction-hongloumeng-jiabaoyu",
      "accountName": "贾宝玉",
      "timestamp": 1768891455,
      "type": 0,
      "content": "那还生不生气？",
      "platformMessageId": "whomi-hongloumeng-v1-dai02-020"
    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1768891500,
      "type": 0,
      "content": "花还没收完，你倒把这一件正事忘了。",
