    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1768891590,
      "type": 0,
      "content": "书先放我这里，我还没看完。花我同你收。",
      "platformMessageId": "whomi-hongloumeng-v1-dai02-023"
    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1769068800,
      "type": 0,
      "content": "你的书里夹着一片花。",
      "platformMessageId": "whomi-hongloumeng-v1-dai03-001"
    },
    {
      "sender": "whomi-fiction-hongloumeng-jiabaoyu",
      "accountName": "贾宝玉",
      "timestamp": 1769068845,
      "type": 0,
      "content": "没收干净的？",
