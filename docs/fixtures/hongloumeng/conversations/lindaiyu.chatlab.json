    },
    {
      "sender": "whomi-fiction-hongloumeng-jiabaoyu",
      "accountName": "贾宝玉",
      "timestamp": 1769069475,
      "type": 0,
      "content": "那我等你看完。",
      "platformMessageId": "whomi-hongloumeng-v1-dai03-016"
    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1769069520,
      "type": 0,
      "content": "这回总算容人把一句看完了。",
