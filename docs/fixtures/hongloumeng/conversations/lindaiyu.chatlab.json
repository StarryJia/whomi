    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1768891230,
      "type": 0,
      "content": "书写得好，你只管看。拿我同你凑一对，就不是看书了。",
