    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1768889565,
      "type": 0,
      "content": "拿稳了。这回别又说水里好。",
      "platformMessageId": "whomi-hongloumeng-v1-dai01-018"
    },
    {
      "sender": "whomi-fiction-hongloumeng-lindaiyu",
      "accountName": "林黛玉",
      "timestamp": 1768890600,
      "type": 0,
      "content": "你方才藏到身后的，是什么书？",
