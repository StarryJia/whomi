    {
      "sender": "whomi-fiction-hongloumeng-jiabaoyu",
      "accountName": "贾宝玉",
      "timestamp": 1768021290,
      "type": 0,
      "content": "老太太喜欢，我知道。可今日是姐姐的生日。",
