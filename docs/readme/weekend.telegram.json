      "id": 4,
      "type": "message",
      "date": "2026-06-06T08:34:00",
      "date_unixtime": "1780706040",
      "from": "阿禾",
      "from_id": "user700000002",
      "text": "当然。把它常睡的蓝毯子也带来，我把书房留给它。"
